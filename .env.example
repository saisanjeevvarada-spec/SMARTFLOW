# ==============================================================================
# SMARTFLOW PRODUCTION ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# ------------------------------------------------------------------------------
FLASK_APP=backend/app.py
FLASK_DEBUG=0
PORT=5000

# PostgreSQL Connection String (Obtained from Supabase -> Project Settings -> Database -> Connection String -> Transaction Pooler)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.example:[YOUR-SUPABASE-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Cryptographic Keys (Generate 32+ character random strings)
SECRET_KEY=smartflow_prod_secret_key_change_in_render_dashboard_32chars
JWT_SECRET_KEY=smartflow_jwt_prod_secret_key_change_in_render_32chars

# CORS Origin Allowlist (Comma-separated list of authorized frontends)
CORS_ALLOWED_ORIGINS=https://smartflow-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Upload Directory
UPLOAD_FOLDER=backend/uploads

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Production Render Backend API URL (Include trailing /api)
VITE_API_BASE_URL=https://smartflow-backend.onrender.com/api

# Google OAuth Client ID for React OAuth Provider
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
